{
  "name": "tabgrant-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "User-granted, local-first access to real browser sessions for AI agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm security:gate",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter tabgrant dev",
    "e2e:chrome": "pnpm e2e:chrome:ci",
    "e2e:chrome:ci": "pnpm build && pnpm --filter tabgrant exec tsx ../../scripts/chrome-e2e.mjs --ci",
    "e2e:chrome:install": "browsers install chrome@152.0.7977.64 --path .cache/tabgrant-browsers",
    "e2e:chrome:manual": "pnpm build && pnpm --filter tabgrant exec tsx ../../scripts/chrome-e2e.mjs --manual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "changeset": "changeset",
    "security:gate": "node scripts/security-gate.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@puppeteer/browsers": "3.2.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
